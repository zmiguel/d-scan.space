# Copy to .env and adjust values as needed.
#
# NOTE: This project has two runtime processes:
# - App (SvelteKit server)
# - Updater worker (cron jobs)
#
# With NODE_ENV=production both processes refuse to start without their required
# variables (app: DATABASE_URL, AUTH_SECRET; worker: DATABASE_URL) and log a warning for
# missing recommended ones (ORIGIN, AUTH_EVEONLINE_*, BODY_SIZE_LIMIT, DB_ENV, CONTACT_EMAIL).
#
# -----------------------------------------------------------------------------
# Docker Compose helpers (not required outside docker-compose)
# -----------------------------------------------------------------------------

# Adminer only runs with `docker compose --profile debug up -d` and listens on 127.0.0.1.
ADMINER_PORT=8080
ADMINER_DEFAULT_SERVER=postgres-main

POSTGRES_USER=dscanspace
POSTGRES_PASSWORD=dscanspace
POSTGRES_DB=dscanspace
POSTGRES_HOSTNAME=postgres-db

# PostgreSQL connection string (used by app, worker, and Drizzle CLI)
DATABASE_URL=postgresql://dscanspace:dscanspace@postgres-main:5432/dscanspace

# DB schema namespace for scans tables ("dev", "preview" or "prod")
DB_ENV=dev

# -----------------------------------------------------------------------------
# App / runtime
# -----------------------------------------------------------------------------

# Where the app listens (adapter-node)
HOST=0.0.0.0
PORT=3000

# Public origin (also used in the ESI User-Agent string)
ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Auth.js / EVE SSO
# -----------------------------------------------------------------------------

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# EVE SSO OAuth app credentials
AUTH_EVEONLINE_ID=
AUTH_EVEONLINE_SECRET=

# Set to true behind proxies/load balancers so Auth.js trusts forwarded host/proto
AUTH_TRUST_HOST=true

# Max request body size (SvelteKit/adapter-node). Examples: 512K, 16M, 32M.
# This is the only size limit for d-scans, which can be very large in big fights
# (16M ≈ 400k typical d-scan lines, ≈ 68k lines of long non-Latin names). If unset,
# adapter-node defaults to 512K, which is too small for large scans.
BODY_SIZE_LIMIT=16M

# Maximum names per local scan (default 12000). D-scans have no line limit.
LOCAL_SCAN_MAX_LINES=12000

# D-scan objects up to this many km away count as on-grid (default 50000).
DSCAN_ON_GRID_MAX_KM=50000

# ESI client: requests in flight per process (default 32) and per-attempt timeout in ms
# (default 15000). Retries, 420/429 back-off and error-limit pauses are automatic.
ESI_MAX_CONCURRENCY=32
ESI_REQUEST_TIMEOUT_MS=15000

# Development only: send `X-Compatibility-Date: 2099-01-01` on character/corporation/
# alliance requests to try upcoming ESI changes. Leave unset in production.
ESI_TEST_FLAGS=false

# -----------------------------------------------------------------------------
# Logging / environment
# -----------------------------------------------------------------------------

NODE_ENV=production
DEPLOYMENT_ENV=prod
LOG_LEVEL=info

# Skip Drizzle migrations on boot (useful for worker or read-only instances).
# Only true/1/yes/on skip; false (or unset) runs them. Concurrent instances are safe:
# migrations run under a Postgres advisory lock. BUILD=true (set by the Dockerfile's
# build step) also skips them; never set BUILD at runtime.
SKIP_MIGRATIONS=false

# Used in the ESI User-Agent string to identify your deployment
AGENT=Self-Hosted

# -----------------------------------------------------------------------------
# EVE Online ESI contact info (MANDATORY!)
# -----------------------------------------------------------------------------

CONTACT_EMAIL=you@example.com
CONTACT_EVE=YourCharacterName
CONTACT_DISCORD=YourDiscord

# -----------------------------------------------------------------------------
# Updater worker (cron)
# -----------------------------------------------------------------------------

# Croner format (5-field crons). Defaults are defined in worker config as well.
# Do not change these unless you understand what you are doing.
# If you set these too low expect CCP to contact you for hammering their servers.
DYNAMIC_UPDATE_CRON=* * * * *
STATIC_UPDATE_CRON=30 11,12 * * *

# On SIGINT/SIGTERM, how long (ms) to wait for a running job before exiting (default
# 6000). Telemetry flushing adds up to 3 s; keep the sum below the container stop timeout.
SHUTDOWN_TIMEOUT_MS=6000

# Docker healthcheck: the worker touches this file after startup and after every job run
# that did not fail; the container is unhealthy when it is older than the max age (ms,
# default 900000 = 15 min). Raise it if DYNAMIC_UPDATE_CRON runs less often than that.
HEALTHCHECK_FILE=/tmp/d-scan-updater.heartbeat
HEALTHCHECK_MAX_AGE_MS=900000

# -----------------------------------------------------------------------------
# OpenTelemetry (optional)
# -----------------------------------------------------------------------------

# OTLP export of traces and metrics, only when set. Either the collector base URL
# (http://collector:4318) or the traces URL (http://collector:4318/v1/traces).
# Empty = no OTLP export (Prometheus /metrics below still works).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_AUTHORIZATION=

# OTLP metric export interval in ms (default 15000). Span batching uses the standard
# OTEL_BSP_* variables.
OTEL_METRIC_EXPORT_INTERVAL=15000

# Set to `prometheus` when the collector accepts traces but not OTLP metrics (its
# /v1/metrics answers 404); metrics then stay on the Prometheus endpoint only.
OTEL_METRICS_EXPORTER=

# Base service name; app/worker append suffixes.
OTEL_SERVICE_NAME=d-scan.space

# Prometheus exporter port (each process binds its own port)
PROMETHEUS_PORT=9464
