{
	"name": "d-scan-space",
	"version": "1.3.0",
	"private": true,
	"engines": {
		"node": ">=26.0.0"
	},
	"scripts": {
		"dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
		"dev-win": "npm run dev",
		"build": "vite build",
		"preview": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js preview --host 0.0.0.0 --port 4173",
		"prod": "node --env-file-if-exists=.env build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"test": "vitest run --coverage",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"db:push": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs push",
		"db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
		"db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
		"db:studio": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs studio"
	},
	"dependencies": {
		"@auth/drizzle-adapter": "^1.11.3",
		"@auth/sveltekit": "^1.11.3",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/auto-instrumentations-node": "^0.80.0",
		"@opentelemetry/core": "^2.11.0",
		"@opentelemetry/exporter-metrics-otlp-proto": "^0.222.0",
		"@opentelemetry/exporter-prometheus": "^0.222.0",
		"@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
		"@opentelemetry/resources": "^2.11.0",
		"@opentelemetry/sdk-metrics": "^2.11.0",
		"@opentelemetry/sdk-node": "^0.222.0",
		"@opentelemetry/sdk-trace-node": "^2.11.0",
		"@opentelemetry/semantic-conventions": "^1.43.0",
		"@resvg/resvg-wasm": "^2.6.2",
		"@sveltejs/kit": "^2.70.3",
		"drizzle-orm": "^0.45.3",
		"flowbite": "^4.0.2",
		"flowbite-svelte": "^1.33.1",
		"flowbite-svelte-icons": "^3.1.0",
		"import-in-the-middle": "^3.5.2",
		"pg": "^8.23.1",
		"pino": "^10.3.1",
		"svelte": "^5.57.1",
		"tailwind-merge": "^3.7.0",
		"undici": "^8.11.2"
	},
	"type": "module",
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.8",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.4",
		"@types/pg": "^8.23.1",
		"@vitest/coverage-v8": "^5.0.3",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"pino-pretty": "^13.1.3",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	}
}
